# ------------------------------------------------------------
# Model files: only the two final trained models are uploaded
# (best.pt, about 5 MB each). Everything else in runs/ is
# regenerated by the scripts.
# ------------------------------------------------------------
*.pt
weights/
/runs/**
!/runs/**/
!/runs/detect/carl-andre-de-castro/runs/yolo26n_final_70_15_15/weights/best.pt
!/runs/detect/carl-andre-de-castro/runs/yolo26n_final_70_15_15/args.yaml
!/runs/detect/carl-andre-de-castro/runs/yolo26n_final_70_15_15/results.csv
!/runs/detect/carl-andre-de-castro/runs/yolo11n_final_70_15_15-2/weights/best.pt
